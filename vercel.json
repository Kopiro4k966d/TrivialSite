{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "storage/launcher/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; img-src 'self' https: data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/(signin|signup|login|register|profile|purchase|payment-success|public-offer|admin-panel)\\.html",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/storage(?:/.*)?",
      "status": 404
    },
    {
      "src": "/server(?:/.*)?",
      "status": 404
    },
    {
      "src": "/database(?:/.*)?",
      "status": 404
    },
    {
      "src": "/scripts(?:/.*)?",
      "status": 404
    },
    {
      "src": "/(?:package\\.json|package-lock\\.json|vercel\\.json|server\\.js|\\.env(?:\\..*)?)",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api(?:/(.*))?",
      "dest": "/api/index.js?__route=$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/signin",
      "dest": "/signin.html"
    },
    {
      "src": "/signup",
      "dest": "/signup.html"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/register",
      "dest": "/register.html"
    },
    {
      "src": "/profile",
      "dest": "/profile.html"
    },
    {
      "src": "/purchase",
      "dest": "/purchase.html"
    },
    {
      "src": "/payment-success",
      "dest": "/payment-success.html"
    },
    {
      "src": "/public-offer",
      "dest": "/public-offer.html"
    },
    {
      "src": "/admin-panel",
      "dest": "/admin-panel.html"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
