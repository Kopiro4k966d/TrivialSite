{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "storage/launcher/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/storage/.*",
      "status": 404
    },
    {
      "src": "/server/.*",
      "status": 404
    },
    {
      "src": "/database/.*",
      "status": 404
    },
    {
      "src": "/scripts/.*",
      "status": 404
    },
    {
      "src": "/package.json",
      "status": 404
    },
    {
      "src": "/package-lock.json",
      "status": 404
    },
    {
      "src": "/vercel.json",
      "status": 404
    },
    {
      "src": "/server.js",
      "status": 404
    },
    {
      "src": "/\\.env.*",
      "status": 404
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/signin",
      "dest": "/signin.html"
    },
    {
      "src": "/signup",
      "dest": "/signup.html"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/register",
      "dest": "/register.html"
    },
    {
      "src": "/profile",
      "dest": "/profile.html"
    },
    {
      "src": "/purchase",
      "dest": "/purchase.html"
    },
    {
      "src": "/payment-success",
      "dest": "/payment-success.html"
    },
    {
      "src": "/public-offer",
      "dest": "/public-offer.html"
    },
    {
      "src": "/admin-panel",
      "dest": "/admin-panel.html"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https: data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
